source_env_if_exists .envrc.local

# Convenience for manual `nixos-rebuild --flake "$HOME_SERVER_FLAKE"`.
export HOME_SERVER_FLAKE="${PWD}#example"

# Borg credentials, repo URLs, and SSH options are NOT defined here on purpose.
# They live in the NixOS config (modules/maintenance.nix) and are baked into the
# generated per-job wrappers: `sudo borg-job-<name> <borg-subcommand>`.
