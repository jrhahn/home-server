{%- comment -%} source_1 = Open-Meteo, source_2 = Home Assistant /api/states {%- endcomment -%}
{%- assign cur = source_1.current -%}
{%- assign day = source_1.daily -%}
{%- assign hr = source_1.hourly -%}

{%- comment -%} Wetter-Icons: nur Flächen, keine Konturen. Das hat auch einen
technischen Grund — Terminus' Sanitizer erlaubt am <svg> nur height/width/x/y/
version/viewbox/shape-rendering, wirft also fill und stroke dort weg. Attribute
an den Kindelementen überleben, Attribute am svg nicht. {%- endcomment -%}
{%- capture i_sun -%}<svg viewBox="0 0 24 24" width="100%" height="100%"><circle cx="12" cy="12" r="5.2" fill="#555555"/><g fill="#555555"><rect x="11.1" y="1.2" width="1.8" height="3.4" rx="0.9"/><rect x="11.1" y="19.4" width="1.8" height="3.4" rx="0.9"/><rect x="1.2" y="11.1" width="3.4" height="1.8" rx="0.9"/><rect x="19.4" y="11.1" width="3.4" height="1.8" rx="0.9"/></g><g fill="#555555" transform="rotate(45 12 12)"><rect x="11.1" y="1.2" width="1.8" height="3.4" rx="0.9"/><rect x="11.1" y="19.4" width="1.8" height="3.4" rx="0.9"/><rect x="1.2" y="11.1" width="3.4" height="1.8" rx="0.9"/><rect x="19.4" y="11.1" width="3.4" height="1.8" rx="0.9"/></g></svg>{%- endcapture -%}
{%- capture i_part -%}<svg viewBox="0 0 24 24" width="100%" height="100%"><circle cx="8.6" cy="7.6" r="3.6" fill="#555555"/><g fill="#555555"><rect x="7.8" y="0.9" width="1.6" height="2.6" rx="0.8"/><rect x="1.1" y="6.8" width="2.6" height="1.6" rx="0.8"/><rect x="2.6" y="2.2" width="1.6" height="2.6" rx="0.8" transform="rotate(-45 3.4 3.5)"/><rect x="13.2" y="2.2" width="1.6" height="2.6" rx="0.8" transform="rotate(45 14 3.5)"/></g><path d="M7.5 20h9.8a3.4 3.4 0 0 0 .3-6.8 5 5 0 0 0-9.6-1 3.9 3.9 0 0 0-.5 7.8z" fill="#AAAAAA"/></svg>{%- endcapture -%}
{%- capture i_cloud -%}<svg viewBox="0 0 24 24" width="100%" height="100%"><path d="M6.8 19h10.4a3.6 3.6 0 0 0 .3-7.2 5.3 5.3 0 0 0-10.2-1.1A3.9 3.9 0 0 0 6.8 19z" fill="#AAAAAA"/></svg>{%- endcapture -%}
{%- capture i_rain1 -%}<svg viewBox="0 0 24 24" width="100%" height="100%"><path d="M6.8 15h10.4a3.6 3.6 0 0 0 .3-7.2 5.3 5.3 0 0 0-10.2-1.1A3.9 3.9 0 0 0 6.8 15z" fill="#AAAAAA"/><rect x="11.2" y="17.2" width="1.7" height="4.8" rx="0.85" fill="#555555" transform="rotate(12 12 19.6)"/></svg>{%- endcapture -%}
{%- capture i_rain2 -%}<svg viewBox="0 0 24 24" width="100%" height="100%"><path d="M6.8 15h10.4a3.6 3.6 0 0 0 .3-7.2 5.3 5.3 0 0 0-10.2-1.1A3.9 3.9 0 0 0 6.8 15z" fill="#AAAAAA"/><g fill="#555555"><rect x="8.6" y="17.2" width="1.7" height="4.8" rx="0.85" transform="rotate(12 9.4 19.6)"/><rect x="13.6" y="17.2" width="1.7" height="4.8" rx="0.85" transform="rotate(12 14.4 19.6)"/></g></svg>{%- endcapture -%}
{%- capture i_rain3 -%}<svg viewBox="0 0 24 24" width="100%" height="100%"><path d="M6.8 15h10.4a3.6 3.6 0 0 0 .3-7.2 5.3 5.3 0 0 0-10.2-1.1A3.9 3.9 0 0 0 6.8 15z" fill="#AAAAAA"/><g fill="#555555"><rect x="6.4" y="17.2" width="1.7" height="4.8" rx="0.85" transform="rotate(12 7.2 19.6)"/><rect x="11.2" y="17.2" width="1.7" height="4.8" rx="0.85" transform="rotate(12 12 19.6)"/><rect x="16" y="17.2" width="1.7" height="4.8" rx="0.85" transform="rotate(12 16.8 19.6)"/></g></svg>{%- endcapture -%}
{%- capture i_snow -%}<svg viewBox="0 0 24 24" width="100%" height="100%"><path d="M6.8 15h10.4a3.6 3.6 0 0 0 .3-7.2 5.3 5.3 0 0 0-10.2-1.1A3.9 3.9 0 0 0 6.8 15z" fill="#AAAAAA"/><g fill="#555555"><rect x="7.4" y="18" width="2.8" height="2.8" transform="rotate(45 8.8 19.4)"/><rect x="11.2" y="19" width="2.8" height="2.8" transform="rotate(45 12.6 20.4)"/><rect x="15" y="18" width="2.8" height="2.8" transform="rotate(45 16.4 19.4)"/></g></svg>{%- endcapture -%}
{%- capture i_storm -%}<svg viewBox="0 0 24 24" width="100%" height="100%"><path d="M6.8 14h10.4a3.6 3.6 0 0 0 .3-7.2 5.3 5.3 0 0 0-10.2-1.1A3.9 3.9 0 0 0 6.8 14z" fill="#AAAAAA"/><polygon points="13.4,15 8.8,20.6 11.9,20.6 10.2,24 15.6,18 12.4,18 14,15" fill="#000000"/></svg>{%- endcapture -%}
{%- capture i_fog -%}<svg viewBox="0 0 24 24" width="100%" height="100%"><rect x="3" y="7.4" width="18" height="1.9" rx="0.95" fill="#555555"/><rect x="5.5" y="11.4" width="13" height="1.9" rx="0.95" fill="#AAAAAA"/><rect x="4" y="15.4" width="16" height="1.9" rx="0.95" fill="#555555"/><rect x="7" y="19.4" width="10" height="1.9" rx="0.95" fill="#AAAAAA"/></svg>{%- endcapture -%}
{%- capture i_moon -%}<svg viewBox="0 0 24 24" width="100%" height="100%"><path d="M20 14.5A8.3 8.3 0 0 1 9.5 4a8.3 8.3 0 1 0 10.5 10.5z" fill="#555555"/></svg>{%- endcapture -%}
{%- capture i_moonc -%}<svg viewBox="0 0 24 24" width="100%" height="100%"><path d="M14.5 9.2A5.6 5.6 0 0 1 8 2.8a5.6 5.6 0 1 0 6.5 6.4z" fill="#555555"/><path d="M7.5 20h9.8a3.4 3.4 0 0 0 .3-6.8 5 5 0 0 0-9.6-1 3.9 3.9 0 0 0-.5 7.8z" fill="#AAAAAA"/></svg>{%- endcapture -%}

{%- assign wc = cur.weather_code -%}
{%- capture icon_now -%}
{%- assign cp = cur.precipitation -%}
{%- assign rn = i_rain1 -%}
{%- if cp >= 0.5 -%}{%- assign rn = i_rain2 -%}{%- endif -%}
{%- if cp >= 2 -%}{%- assign rn = i_rain3 -%}{%- endif -%}
{%- assign dnow = cur.is_day -%}
{%- case wc -%}
  {%- when 0, 1 -%}{% if dnow == 0 %}{{ i_moon }}{% else %}{{ i_sun }}{% endif %}
  {%- when 2 -%}{% if dnow == 0 %}{{ i_moonc }}{% else %}{{ i_part }}{% endif %}
  {%- when 45, 48 -%}{{ i_fog }}
  {%- when 71, 73, 75, 77, 85, 86 -%}{{ i_snow }}
  {%- when 95, 96, 99 -%}{{ i_storm }}
  {%- when 3 -%}{{ i_cloud }}
  {%- else -%}{{ rn }}
{%- endcase -%}
{%- endcapture -%}
{%- comment -%} Räume: aus den Sensornamen abgeleitet, siehe README {%- endcomment -%}
{%- assign acc = "" -%}
{%- for s in source_2 -%}
  {%- assign dc = s.attributes.device_class -%}
  {%- assign fn = s.attributes.friendly_name -%}
  {%- if fn -%}
    {%- assign keep = false -%}
    {%- if dc == "temperature" or dc == "humidity" or dc == "carbon_dioxide" -%}{%- assign keep = true -%}{%- endif -%}
    {%- if dc == "pm25" or dc == "pm10" -%}{%- assign keep = true -%}{%- endif -%}
    {%- comment -%} Der Vogelzähler hat keine device_class, also über den Namen {%- endcomment -%}
    {%- if fn contains "Vogel" -%}{%- assign keep = true -%}{%- endif -%}
    {%- if keep -%}
      {%- assign word = fn | split: " " | first -%}
      {%- assign acc = acc | append: word | append: "|" -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- assign rooms = acc | split: "|" | uniq | sort -%}

{%- comment -%} Gewünschte Reihenfolge im 2x3-Raster, zeilenweise gefüllt. Räume, die
hier nicht stehen, hängen alphabetisch hinten an — die Ableitung aus den Sensornamen
bleibt damit intakt, ein neuer Raum erscheint weiter von selbst {%- endcomment -%}
{%- assign preferred = "Wohnzimmer|Schlafzimmer|Küche|Bad|Terrasse" | split: "|" -%}
{%- assign ordered = "" -%}
{%- for r in preferred -%}
  {%- if rooms contains r -%}{%- assign ordered = ordered | append: r | append: "|" -%}{%- endif -%}
{%- endfor -%}
{%- for r in rooms -%}
  {%- unless preferred contains r -%}{%- assign ordered = ordered | append: r | append: "|" -%}{%- endunless -%}
{%- endfor -%}
{%- assign rooms = ordered | split: "|" -%}

{%- comment -%} Radar: RainViewer hält 120 Minuten in 10-Minuten-Schritten vor {%- endcomment -%}
{%- assign host = source_3.host -%}
{%- assign past = source_3.radar.past -%}
{%- assign i0 = past.size | minus: 1 -%}
{%- assign i1 = i0 | minus: 6 -%}
{%- assign i2 = i0 | minus: 12 -%}
{%- if i1 < 0 -%}{%- assign i1 = 0 -%}{%- endif -%}
{%- if i2 < 0 -%}{%- assign i2 = 0 -%}{%- endif -%}
{%- assign now_s = 'now' | date: '%s' | times: 1 -%}
{%- assign radar_age = now_s | minus: past[i0].time | divided_by: 60 -%}
{%- capture paths -%}{{ past[i2].path }}|{{ past[i1].path }}|{{ past[i0].path }}{%- endcapture -%}
{%- assign frames = paths | split: "|" -%}
{%- assign frame_labels = "vor 2 h|vor 1 h|jetzt" | split: "|" -%}

<div style="display:flex;flex-direction:row;align-items:stretch;width:100%;gap:16px">

  {%- comment -%} Jetzt: hoch und schmal. Der Umbruch vor Sonnenauf- und -untergang
  ist der Grund, dass es schmal sein darf — vorher stand alles in einer Zeile und
  die diktierte die Breite des ganzen Blocks {%- endcomment -%}
  <span style="display:flex;flex-direction:column;justify-content:space-between;width:148px;flex:none">
    <span style="display:inline-block;width:64px;height:64px">{{ icon_now }}</span>
    <span style="display:flex;flex-direction:column">
    <span class="value value--large">{{ cur.temperature_2m | round }}<span style="color:#555555">&deg;</span></span>
    <span class="label label--small">
      {%- case wc -%}
      {%- when 0 -%}klar{%- when 1 -%}überwiegend klar{%- when 2 -%}wechselnd bewölkt
      {%- when 3 -%}bedeckt{%- when 45, 48 -%}Nebel
      {%- when 51, 53, 55, 56, 57 -%}Niesel{%- when 61, 63, 65, 66, 67 -%}Regen
      {%- when 71, 73, 75, 77 -%}Schnee{%- when 80, 81, 82 -%}Schauer
      {%- when 85, 86 -%}Schneeschauer{%- when 95, 96, 99 -%}Gewitter
      {%- else -%}&mdash;{%- endcase %} &middot; {{ cur.relative_humidity_2m }}&nbsp;% rF
    </span>
    {%- comment -%} Windrichtung meteorologisch: der Pfeil zeigt, wohin der Wind
    weht (Richtung + 180), der Text nennt woher er kommt. Achtsektoren, damit
    "aus SW" statt 199 Grad dasteht {%- endcomment -%}
    {%- assign wdir = cur.wind_direction_10m -%}
    {%- assign wsec = wdir | plus: 22.5 | divided_by: 45.0 | floor | modulo: 8 -%}
    {%- assign warrow = wdir | plus: 180 -%}
    {%- if cur.wind_speed_10m -%}
    <span class="label label--small" style="display:flex;flex-direction:row;align-items:center;gap:5px">
      <span style="display:inline-block;width:13px;height:13px;flex:none">
        <svg viewBox="0 0 16 16" width="13" height="13">
          <g transform="rotate({{ warrow }} 8 8)" fill="#555555">
            <polygon points="8,1.4 12.4,7.2 9.4,7.2 9.4,14.6 6.6,14.6 6.6,7.2 3.6,7.2"/>
          </g>
        </svg>
      </span>
      {%- comment -%} Alles auf einer Zeile und ohne Bindestrich am when: ein
      {%- when 4 -%} würde das Leerzeichen vor dem Kürzel schlucken {%- endcomment -%}
      <span>aus {% case wsec %}{% when 0 %}N{% when 1 %}NO{% when 2 %}O{% when 3 %}SO{% when 4 %}S{% when 5 %}SW{% when 6 %}W{% else %}NW{% endcase %} &middot; {{ cur.wind_speed_10m | round }}&nbsp;km/h</span>
    </span>
    {%- comment -%} Böen erst ab 40 km/h: darunter sagt das Mittel genug, und die
    Zeile kostet Platz, den das Widget nur einmal hat {%- endcomment -%}
    {%- if cur.wind_gusts_10m >= 40 -%}
    <span class="label label--small" style="color:#555555">Böen {{ cur.wind_gusts_10m | round }}&nbsp;km/h</span>
    {%- endif -%}
    {%- endif -%}
    <span class="label label--small">Darmstadt {{ day.temperature_2m_min[0] | round }}&deg;&ndash;{{ day.temperature_2m_max[0] | round }}&deg;</span>
    <span class="label label--small" style="color:#555555;white-space:nowrap">auf {{ day.sunrise[0] | date: "%H:%M" }} &middot; unter {{ day.sunset[0] | date: "%H:%M" }}</span>
    </span>
  </span>

  <span style="display:flex;flex-direction:column;flex:1;min-width:0">
    {%- comment -%} Zeile 1: die nächsten fünf Tage {%- endcomment -%}
  <div style="display:flex;flex-direction:row;justify-content:space-between;width:100%">
    {%- for i in (1..5) -%}
      {%- assign dc2 = day.weather_code[i] -%}
      <span style="display:flex;flex-direction:column;align-items:center;flex:1">
        <span class="label label--small">
          {%- assign wd = day.time[i] | date: "%w" -%}
          {%- case wd -%}
            {%- when "0" -%}So{%- when "1" -%}Mo{%- when "2" -%}Di{%- when "3" -%}Mi
            {%- when "4" -%}Do{%- when "5" -%}Fr{%- else -%}Sa
          {%- endcase -%}
        </span>
        {%- assign dsum = day.precipitation_sum[i] -%}
      {%- assign rn = i_rain1 -%}
      {%- if dsum >= 1 -%}{%- assign rn = i_rain2 -%}{%- endif -%}
      {%- if dsum >= 5 -%}{%- assign rn = i_rain3 -%}{%- endif -%}
      <span style="display:inline-block;width:22px;height:22px">
          {%- case dc2 -%}
            {%- when 0, 1 -%}{{ i_sun }}
            {%- when 2 -%}{{ i_part }}
            {%- when 45, 48 -%}{{ i_fog }}
            {%- when 71, 73, 75, 77, 85, 86 -%}{{ i_snow }}
            {%- when 95, 96, 99 -%}{{ i_storm }}
            {%- when 3 -%}{{ i_cloud }}
            {%- else -%}{{ rn }}
          {%- endcase -%}
        </span>
        {%- comment -%} Höchst- und Tiefstwert in einer Zeile: die Tageszeile ist eine
        Zusammenfassung, und die gesparten 14 px sind Luft für die Blöcke darunter {%- endcomment -%}
        <span style="display:flex;flex-direction:row;align-items:baseline;gap:4px">
          <span class="value value--small">{{ day.temperature_2m_max[i] | round }}<span style="color:#555555">&deg;</span></span>
          <span class="label label--small" style="color:#555555">{{ day.temperature_2m_min[i] | round }}&deg;</span>
        </span>
        {%- if dsum > 0 -%}<span class="label label--small" style="color:#555555;white-space:nowrap">{{ dsum }}&nbsp;mm</span>{%- endif -%}
      </span>
    {%- endfor -%}
  </div>
    {%- comment -%} Zeile 2: die nächsten acht Stunden {%- endcomment -%}
<span style="display:flex;flex-direction:column;width:100%;margin-top:6px">
   <span class="label label--underline" style="justify-content:space-between;width:100%;margin-top:7px">
     <span>Stündlich</span>
     <span class="label label--small" style="font-weight:400;color:#555555">nächste 8 Stunden</span>
   </span>
   <div style="display:flex;flex-direction:row;justify-content:space-between;width:100%;margin-top:3px">
     {%- for i in (1..8) -%}
       {%- assign t = hr.time[i] -%}
       {%- if t -%}
       {%- assign c = hr.weather_code[i] -%}
       {%- assign p = hr.precipitation_probability[i] -%}
       <span style="display:flex;flex-direction:column;align-items:center;flex:1">
         {%- comment -%} Windpfeil neben die Stunde statt in eine eigene Zeile:
         eine weitere Zeile hätte der Kopfblock nicht mehr {%- endcomment -%}
         <span class="label label--small" style="display:flex;flex-direction:row;align-items:center;gap:3px">{{ t | date: "%H" }}
           {%- if hr.wind_direction_10m[i] -%}
           <span style="display:inline-block;width:10px;height:10px;flex:none">
             <svg viewBox="0 0 16 16" width="10" height="10">
               <g transform="rotate({{ hr.wind_direction_10m[i] | plus: 180 }} 8 8)" fill="#555555">
                 <polygon points="8,1.4 12.4,7.2 9.4,7.2 9.4,14.6 6.6,14.6 6.6,7.2 3.6,7.2"/>
               </g>
             </svg>
           </span>
           {%- endif -%}
         </span>
         <span style="display:inline-block;width:22px;height:22px">
           {%- assign hm = hr.precipitation[i] -%}
           {%- assign rn = i_rain1 -%}
           {%- if hm >= 0.5 -%}{%- assign rn = i_rain2 -%}{%- endif -%}
           {%- if hm >= 2 -%}{%- assign rn = i_rain3 -%}{%- endif -%}
           {%- assign dh = hr.is_day[i] -%}
           {%- case c -%}
             {%- when 0, 1 -%}{% if dh == 0 %}{{ i_moon }}{% else %}{{ i_sun }}{% endif %}
             {%- when 2 -%}{% if dh == 0 %}{{ i_moonc }}{% else %}{{ i_part }}{% endif %}
             {%- when 45, 48 -%}{{ i_fog }}
             {%- when 71, 73, 75, 77, 85, 86 -%}{{ i_snow }}
             {%- when 95, 96, 99 -%}{{ i_storm }}
             {%- when 3 -%}{{ i_cloud }}
             {%- else -%}{{ rn }}
           {%- endcase -%}
         </span>
         <span class="value value--small">{{ hr.temperature_2m[i] | round }}<span style="color:#555555">&deg;</span></span>
         {%- assign mm = hr.precipitation[i] -%}
         {%- if mm > 0 -%}
           <span class="label label--small" style="color:#555555;white-space:nowrap">{{ mm }}&nbsp;mm</span>
         {%- elsif p > 0 -%}
           <span class="label label--small" style="color:#AAAAAA">{{ p }}&nbsp;%</span>
         {%- else -%}
           <span class="label label--small" style="color:#AAAAAA">&middot;</span>
         {%- endif -%}
       </span>
       {%- endif -%}
     {%- endfor -%}
   </div>
  </span>
  </span>
</div>

<div style="display:flex;flex-direction:row;align-items:flex-start;flex:1;width:100%;margin-top:5px;gap:18px">

  {%- comment -%} Linke Spalte: Räume als 2x3-Raster, das Panel selbst als letzte Kachel {%- endcomment -%}
  <span style="display:flex;flex-direction:column;flex:1;min-width:0">
    <span class="label label--underline" style="width:100%">Räume</span>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px 20px;margin-top:4px;width:100%">
      {%- for room in rooms -%}
        {%- assign rt = "" -%}{%- assign rh = "" -%}{%- assign rc = "" -%}{%- assign tw = 99 -%}
        {%- assign p25 = "" -%}{%- assign p10 = "" -%}{%- assign vheute = "" -%}{%- assign vtotal = "" -%}
        {%- for s in source_2 -%}
          {%- assign fn = s.attributes.friendly_name -%}
          {%- if fn -%}
            {%- assign r = fn | split: " " | first -%}
            {%- if r == room -%}
              {%- assign st = s.state -%}
              {%- if st != "unavailable" and st != "unknown" and st != "none" -%}
                {%- assign dc = s.attributes.device_class -%}
                {%- assign nw = fn | split: " " | size -%}
                {%- if dc == "temperature" and nw < tw -%}{%- assign rt = st -%}{%- assign tw = nw -%}{%- endif -%}
                {%- if dc == "humidity" and rh == "" -%}{%- assign rh = st -%}{%- endif -%}
                {%- if dc == "carbon_dioxide" and rc == "" -%}{%- assign rc = st -%}{%- endif -%}
                {%- if dc == "pm25" and p25 == "" -%}{%- assign p25 = st -%}{%- endif -%}
                {%- if dc == "pm10" and p10 == "" -%}{%- assign p10 = st -%}{%- endif -%}
                {%- if fn contains "Vogel" -%}
                  {%- assign lower = fn | downcase -%}
                  {%- if lower contains "heute" -%}{%- assign vheute = st -%}
                  {%- elsif lower contains "total" or lower contains "gesamt" -%}{%- assign vtotal = st -%}{%- endif -%}
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        <span style="display:flex;flex-direction:column;align-items:flex-start">
          <span class="label label--small">{{ room }}</span>
          <span class="value value--small">{% if rt != "" %}{{ rt | round: 1 }}<span style="color:#555555">&deg;</span>{% else %}<span style="color:#555555">&mdash;</span>{% endif %}</span>
          {%- comment -%} Feuchte und CO2 teilen eine Zeile: drei Zeilen pro Kachel
          sind das Budget, wenn drei Reihen in die halbe Höhe müssen {%- endcomment -%}
          <span class="label label--small" style="white-space:nowrap">
            {%- if rt == "" -%}<span style="color:#555555">offline</span>
            {%- else -%}
              {%- if rh != "" -%}{{ rh | round }}<span style="color:#555555">&nbsp;%</span>{%- endif -%}
              {%- if rh != "" and rc != "" -%}<span style="color:#AAAAAA">&nbsp;&middot;&nbsp;</span>{%- endif -%}
              {%- if rc != "" -%}{{ rc | round }}<span style="color:#555555">&nbsp;ppm</span>{%- endif -%}
            {%- endif -%}
          </span>
          {%- if rc != "" -%}
            {%- assign rcn = rc | times: 1 -%}
            {%- assign cw = rcn | times: 100.0 | divided_by: 2000.0 -%}
            {%- if cw > 100 -%}{%- assign cw = 100 -%}{%- endif -%}
            <span style="display:block;position:relative;width:92%;height:9px;background:#AAAAAA;margin-top:3px">
              <span style="position:absolute;left:0;top:0;height:9px;width:{{ cw }}%;background:{% if rcn > 1000 %}#000000{% else %}#555555{% endif %}"></span>
              <span style="position:absolute;left:50%;top:-3px;width:2px;height:15px;background:#000000"></span>
            </span>
          {%- endif -%}
          {%- if p25 != "" or p10 != "" -%}
            <span class="label label--small" style="color:#555555;white-space:nowrap;margin-top:2px">
              {%- if p25 != "" -%}PM2.5&nbsp;{{ p25 | round }}{%- endif -%}
              {%- if p25 != "" and p10 != "" -%}<span style="color:#AAAAAA">&nbsp;&middot;&nbsp;</span>{%- endif -%}
              {%- if p10 != "" -%}PM10&nbsp;{{ p10 | round }}{%- endif -%}
            </span>
          {%- endif -%}
          {%- if vheute != "" or vtotal != "" -%}
            {%- comment -%} Eine Zeile, nicht zwei: die Kachelreihen müssen in die
            halbe Screenhöhe {%- endcomment -%}
            <span class="label label--small" style="color:#555555;white-space:nowrap;margin-top:2px">Vögel {% if vheute != "" %}{{ vheute | round }}{% else %}&mdash;{% endif %}<span style="color:#AAAAAA">&nbsp;&middot;&nbsp;</span>{% if vtotal != "" %}{{ vtotal | round }}{% else %}&mdash;{% endif %}</span>
          {%- endif -%}
        </span>
      {%- endfor -%}
      {%- comment -%} Das Panel als eigene Kachel: rutscht mit, wenn Räume dazukommen {%- endcomment -%}
      {%- assign bat = extension.device.battery_percentage -%}
      {%- assign wifi = extension.device.wifi_percentage -%}
      {%- if bat or wifi -%}
      <span style="display:flex;flex-direction:column;align-items:flex-start">
        <span class="label label--small" style="color:#555555">Panel</span>
        <span style="display:flex;flex-direction:row;align-items:center;gap:5px;margin-top:3px;font-family:var(--label-small-font-family);font-size:var(--label-small-font-size);line-height:1">
          {%- assign bfill = bat | times: 16 | divided_by: 100 -%}
          <span style="display:inline-block;width:26px;height:14px;flex:none">
            <svg viewBox="0 0 26 14" width="26" height="14">
              <rect x="0" y="0" width="22" height="14" fill="#000000"/>
              <rect x="2" y="2" width="18" height="10" fill="#FFFFFF"/>
              <rect x="22" y="4" width="4" height="6" fill="#000000"/>
              {%- if bfill > 0 -%}<rect x="3" y="3" width="{{ bfill }}" height="8" fill="{% if bat <= 20 %}#000000{% else %}#555555{% endif %}"/>{%- endif -%}
            </svg>
          </span>
          {%- if bat > 0 -%}<span>{{ bat }}<span style="color:#555555">&nbsp;%</span></span>
          {%- else -%}<span style="color:#555555">&mdash;</span>{%- endif -%}
        </span>
        <span style="display:flex;flex-direction:row;align-items:center;gap:5px;margin-top:4px;font-family:var(--label-small-font-family);font-size:var(--label-small-font-size);line-height:1">
          <span style="display:inline-block;width:16px;height:14px;flex:none">
            <svg viewBox="0 0 16 14" width="16" height="14">
              <rect x="0" y="9" width="4" height="5" fill="{% if wifi >= 20 %}#000000{% else %}#AAAAAA{% endif %}"/>
              <rect x="6" y="5" width="4" height="9" fill="{% if wifi >= 40 %}#000000{% else %}#AAAAAA{% endif %}"/>
              <rect x="12" y="1" width="4" height="13" fill="{% if wifi >= 60 %}#000000{% else %}#AAAAAA{% endif %}"/>
            </svg>
          </span>
          {%- if wifi > 0 -%}<span>{{ wifi }}<span style="color:#555555">&nbsp;%</span></span>
          {%- else -%}<span style="color:#555555">&mdash;</span>{%- endif -%}
        </span>
      </span>
      {%- endif -%}
    </div>
  </span>

  <span style="display:flex;flex-direction:column;width:532px;flex:none">
    <span class="label label--underline" style="justify-content:space-between;width:100%">
      <span>Radar</span>
      <span class="label label--small" style="font-weight:400;color:#555555">130&nbsp;km O/W &middot; 165&nbsp;km N/S &middot; Bild vor {{ radar_age }}&nbsp;Min.</span>
    </span>
    <div style="display:flex;flex-direction:row;justify-content:flex-start;gap:8px;width:100%;margin-top:3px">
      {%- for p in frames -%}
      <span style="display:flex;flex-direction:column;align-items:center">
        <span class="label label--small" style="margin-bottom:3px;{% if forloop.last %}color:#000000{% else %}color:#555555{% endif %}">{{ frame_labels[forloop.index0] }}</span>
        <span style="position:relative;display:block;width:166px;height:209px;overflow:hidden;background:#FFFFFF">
          {%- comment -%} Zoom 6, 1576 m/px: 166x209 px = 262x329 km,
          also 131 km nach Osten und Westen, 165 km nach Norden und Süden.
          Fenster liegt in einer Tile-Spalte, also zwei Bilder pro Frame {%- endcomment -%}
          <img src="{{ host }}{{ p }}/256/6/33/21/0/1_1.png" alt="" width="256" height="256" style="position:absolute;left:-55px;top:-85px;width:256px;height:256px;filter:grayscale(1)">
          <img src="{{ host }}{{ p }}/256/6/33/22/0/1_1.png" alt="" width="256" height="256" style="position:absolute;left:-55px;top:171px;width:256px;height:256px;filter:grayscale(1)">
          <svg viewBox="0 0 166 209" width="166" height="209" style="position:absolute;left:0;top:0">
            <rect x="77" y="105" width="13" height="1" fill="#000000"/>
            <rect x="83" y="99" width="1" height="13" fill="#000000"/>
            <rect x="73" y="101" width="5" height="1" fill="#555555"/>{%- comment -%} GG {%- endcomment -%}
            <rect x="75" y="99" width="1" height="5" fill="#555555"/>
            <rect x="82" y="138" width="5" height="1" fill="#555555"/>{%- comment -%} HD {%- endcomment -%}
            <rect x="84" y="136" width="1" height="5" fill="#555555"/>
          </svg>
          <span class="label label--small" style="position:absolute;left:90px;top:98px;background:#FFFFFF;color:#000000">DA</span>
          <span class="label label--small" style="position:absolute;left:47px;top:83px;background:#FFFFFF;color:#555555">GG</span>
          <span class="label label--small" style="position:absolute;left:91px;top:131px;background:#FFFFFF;color:#555555">HD</span>
        </span>
      </span>
        {%- comment -%} Kein Rahmen ums Bild, aber ohne irgendeine Trennung laufen die
        drei Ausschnitte zu einem Band zusammen und man sieht nicht mehr, welches
        Echo zu welcher Zeit gehört {%- endcomment -%}
        {%- unless forloop.last -%}
        <span style="display:block;width:1px;height:209px;background:#AAAAAA;align-self:flex-end"></span>
        {%- endunless -%}
      {%- endfor -%}
    </div>
   </span>
</div>